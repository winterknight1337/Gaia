[Unit]
Description=Mythic redirector tunnel via autossh created by Gaia
After=network.target

[Service]
User=
ExecStart=/usr/bin/ssh -o 'ServerAliveInterval 30' -o 'ServerAliveCountMax 3' -o 'StrictHostKeyChecking=no' -N -f -R 8443:localhost:80 -i /home/example/.ssh/gaia-redir.pem user@example.com
Restart=on-failure

[Install]
WantedBy=multi-user.target
